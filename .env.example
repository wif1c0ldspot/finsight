# Copy to .env in the repository root. .env is Git-ignored.
# Defaults run against local Ollama after models are downloaded.
FINSIGHT_LLM_PROVIDER=ollama
FINSIGHT_LLM_MODEL=qwen3:8b
FINSIGHT_EMBED_PROVIDER=ollama
FINSIGHT_EMBED_MODEL=nomic-embed-text

# Optional endpoints/credentials. Use your own secrets; never commit .env.
# Compatible providers require an explicit corresponding base URL.
# FINSIGHT_OLLAMA_BASE_URL=http://localhost:11434
# FINSIGHT_LLM_BASE_URL=http://localhost:8000/v1
# FINSIGHT_LLM_API_KEY=
# FINSIGHT_EMBED_BASE_URL=http://localhost:8000/v1
# FINSIGHT_EMBED_API_KEY=

# Set only to an embedding revision you actually operate/know.
# Identity is operator-supplied, not verified against provider model weights.
# If a mutable alias changes, update the revision or use `finsight ingest --full`.
# FINSIGHT_EMBED_REVISION=

# Optional separate evaluation judge; no separate judge means self-grading.
# FINSIGHT_JUDGE_PROVIDER=ollama
# FINSIGHT_JUDGE_MODEL=
# FINSIGHT_JUDGE_BASE_URL=
# FINSIGHT_JUDGE_API_KEY=

# Request settings. SDK retries are not separate logical runtime model calls.
# FINSIGHT_LLM_TEMPERATURE=0.0
# FINSIGHT_LLM_TIMEOUT_S=60
# FINSIGHT_LLM_MAX_RETRIES=3
# FINSIGHT_EMBED_TIMEOUT_S=60
# FINSIGHT_EMBED_MAX_RETRIES=3

# Corpus/index paths are relative to the process working directory.
# FINSIGHT_CORPUS_DIR=data/corpus
# FINSIGHT_INDEX_DIR=data/index
# FINSIGHT_CHROMA_DIR=data/chroma
# FINSIGHT_GOLDEN_FILE=data/golden/golden.json
# FINSIGHT_COLLECTION_NAME=finsight

# Chunk/context defaults. Overlap must be smaller than chunk size.
# FINSIGHT_CHUNK_SIZE=600
# FINSIGHT_CHUNK_OVERLAP=100
# FINSIGHT_CONTEXT_MAX_CHARS=12000
# FINSIGHT_RETRIEVAL_TOP_K=4
# FINSIGHT_RETRIEVAL_CANDIDATES=8
# FINSIGHT_MAX_RETRIEVAL_ATTEMPTS=2
# FINSIGHT_ENFORCE_GROUNDING=true
# FINSIGHT_USE_MCP_TOOLS=true

# Optional content-token bounds; disabled when omitted.
# Without an injected exact counter these count UTF-8 content bytes, not framing.
# Values below illustrate controls, not measured model/hardware recommendations.
# FINSIGHT_CHUNK_MAX_TOKENS=600
# FINSIGHT_CONTEXT_MAX_TOKENS=6000

# Optional model-judged quality checks; disabled pending measured benefit.
# FINSIGHT_RERANK_ENABLED=false
# FINSIGHT_SEMANTIC_VERIFICATION=false
# FINSIGHT_SEMANTIC_MAX_SEGMENTS=24

# Optional per-agent-invocation controls; all disabled when omitted.
# Deadlines/cancellation are cooperative and cannot preempt synchronous calls.
# FINSIGHT_RUN_TIMEOUT_S=120
# FINSIGHT_RUN_MAX_MODEL_CALLS=12
# FINSIGHT_RUN_MAX_INPUT_TOKENS=100000
# FINSIGHT_RUN_MAX_OUTPUT_TOKENS=10000
# FINSIGHT_LLM_MAX_OUTPUT_TOKENS=1000

# Optional costs: fill in actual USD rates and a chosen budget before uncommenting.
# No prices are assumed. A cost budget requires BOTH input and output rates.
# Estimates exclude embeddings, evaluation judges and hidden provider retries.
# FINSIGHT_INPUT_COST_PER_MILLION=
# FINSIGHT_OUTPUT_COST_PER_MILLION=
# FINSIGHT_RUN_MAX_COST_USD=
